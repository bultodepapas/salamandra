# Raw flight data (large) — use LFS
tests/**/raw/*.bin
tests/**/raw/*.BIN
tests/**/raw/*.ulg

# Wiki (Astro Starlight) — build artifacts and generated content
wiki/node_modules/
wiki/dist/
wiki/.astro/
wiki/src/content/docs/
wiki/public/drawings/

# System
.DS_Store
Thumbs.db
