---
interface Props {
  diagram: string;
}

const { diagram } = Astro.props;
---

<figure class="mermaid-diagram" data-mermaid-source={diagram.trim()}>
  <pre class="mermaid">{diagram.trim()}</pre>
</figure>

<script>
  // Mermaid is lazy-loaded and re-rendered from the preserved source whenever
  // Starlight changes theme, so SVG colors and accessible descriptions stay current.

  let renderSequence = 0;
  let rendering = false;

  function isDark() {
    const theme = document.documentElement.dataset.theme;
    if (theme === 'dark') return true;
    if (theme === 'light') return false;
    return window.matchMedia('(prefers-color-scheme: dark)').matches;
  }

  async function renderAll() {
    if (rendering) return;
    const nodes = document.querySelectorAll<HTMLElement>('figure.mermaid-diagram');
    if (!nodes.length) return;
    rendering = true;
    try {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: isDark() ? 'dark' : 'default',
      });
      for (const [i, el] of Array.from(nodes).entries()) {
        const source = el.dataset.mermaidSource || '';
        if (!source) continue;
        try {
          const { svg, bindFunctions } = await mermaid.render(
            `mermaid-svg-${renderSequence}-${i}`,
            source,
          );
          el.innerHTML = svg;
          bindFunctions?.(el);
        } catch (err) {
          el.innerHTML = '';
          const fallback = document.createElement('pre');
          fallback.className = 'mermaid';
          fallback.textContent = source;
          el.append(fallback);
          console.warn('Mermaid render failed:', err);
        }
      }
      renderSequence += 1;
    } finally {
      rendering = false;
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderAll);
  } else {
    renderAll();
  }

  document.addEventListener('astro:page-load', renderAll);

  // Re-render when Starlight toggles the theme (data-theme attribute).
  new MutationObserver(() => renderAll()).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ['data-theme'],
  });
</script>
